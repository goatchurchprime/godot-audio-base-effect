[configuration]

entry_symbol = "two_voip_library_init"
compatibility_minimum = "4.6.0"
reloadable = false

[dependencies]

; example.x86_64 = { "relative or absolute path to the dependency" : "the path relative to the exported project", }
; -------------------------------------
; debug

macos = { }
windows.x86_64 = { }
linux.x86_64 = { }

; by default godot is using threads
web.wasm32.nothreads = {}
web.wasm32 = {}

android.arm32 = { }
android.arm64 = { }
android.x86_32 = { }
android.x86_64 = { }

ios = {}

; -------------------------------------
; release

macos.template_release = { }
windows.template_release.x86_64 = { }
linux.template_release.x86_64 = { }

web.template_release.wasm32.nothreads = { }
web.template_release.wasm32 = { }

android.template_release.arm32 = { }
android.template_release.arm64 = { }
android.template_release.x86_32 = { }
android.template_release.x86_64 = { }

ios.template_release = {}

[libraries]

; -------------------------------------
; debug

macos = "libs/libbaseeffect.macos.template_debug.universal.framework"
windows.x86_64 = "libs/libbaseeffect.windows.template_debug.x86_64.dll"
linux.x86_64 = "libs/libbaseeffect.linux.template_debug.x86_64.so"

web.wasm32.nothreads = "libs/libbaseeffect.web.template_debug.wasm32.wasm"
web.wasm32 = "libs/libbaseeffect.web.template_debug.wasm32.threads.wasm"

android.arm32 = "libs/libbaseeffect.android.template_debug.arm32.so"
android.arm64 = "libs/libbaseeffect.android.template_debug.arm64.so"
android.x86_32 = "libs/libbaseeffect.android.template_debug.x86_32.so"
android.x86_64 = "libs/libbaseeffect.android.template_debug.x86_64.so"

ios = "libs/libbaseeffect.ios.template_debug.universal.dylib"

; -------------------------------------
; release

macos.template_release = "libs/libbaseeffect.macos.template_release.universal.framework"
windows.template_release.x86_64 = "libs/libbaseeffect.windows.template_release.x86_64.dll"
linux.template_release.x86_64 = "libs/libbaseeffect.linux.template_release.x86_64.so"

web.template_release.wasm32.nothreads = "libs/libbaseeffect.web.template_release.wasm32.wasm"
web.template_release.wasm32 = "libs/libbaseeffect.web.template_release.wasm32.threads.wasm"

android.template_release.arm32 = "libs/libbaseeffect.android.template_release.arm32.so"
android.template_release.arm64 = "libs/libbaseeffect.android.template_release.arm64.so"
android.template_release.x86_32 = "libs/libbaseeffect.android.template_release.x86_32.so"
android.template_release.x86_64 = "libs/libbaseeffect.android.template_release.x86_64.so"

ios.template_release = "libs/libbaseeffect.ios.template_release.universal.dylib"
